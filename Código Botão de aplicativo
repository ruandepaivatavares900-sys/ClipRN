.google-btn{
    width:100%;
    padding:14px;
    margin-top:15px;
    background:#fff;
    color:#444;
    border:2px solid #ddd;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
    transition:.3s;
}

.google-btn:hover{
    background:#f5f5f5;
}

.google-btn img{
    width:22px;
    height:22px;
}
