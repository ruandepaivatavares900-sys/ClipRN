<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ClipRN</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f6f6f6;
display:flex;
justify-content:center;
align-items:center;
min-height:100vh;
padding:20px;
}

.card{
width:100%;
max-width:400px;
background:#fff;
padding:35px;
border-radius:28px;
box-shadow:0 15px 40px rgba(0,0,0,.12);
}

.logo{
width:90px;
height:90px;
margin:auto;
border-radius:24px;
background:linear-gradient(135deg,#ff9800,#ff5e00);
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-size:42px;
font-weight:bold;
}

h1{
text-align:center;
color:#ff6a00;
margin-top:20px;
font-size:34px;
}

.sub{
text-align:center;
color:#666;
margin:10px 0 30px;
}

input{
width:100%;
padding:15px;
margin-bottom:18px;
border:2px solid #ffd7b3;
border-radius:14px;
font-size:16px;
}

input:focus{
outline:none;
border-color:#ff6a00;
}

.login{
width:100%;
padding:16px;
border:none;
border-radius:14px;
background:linear-gradient(135deg,#ff9800,#ff6a00);
color:#fff;
font-size:17px;
font-weight:bold;
cursor:pointer;
}

.google{
margin-top:15px;
width:100%;
padding:15px;
background:#fff;
border:2px solid #ddd;
border-radius:14px;
font-size:16px;
font-weight:bold;
cursor:pointer;
}

.links{
display:flex;
justify-content:space-between;
margin-top:20px;
}

.links a{
text-decoration:none;
color:#ff6a00;
font-weight:bold;
font-size:14px;
}

footer{
margin-top:30px;
text-align:center;
color:#999;
font-size:13px;
}

@media(max-width:480px){
.card{
padding:25px;
}
}
</style>

</head>
<body>

<div class="card">

<div class="logo">▶</div>

<h1>ClipRN</h1>

<p class="sub">
Conectando clipadores e anunciantes
</p>

<input type="email" placeholder="Digite seu e-mail">

<input type="password" placeholder="Digite sua senha">

<button class="login">Entrar</button>

<button class="google">Continuar com Google</button>

<div class="links">
<a href="#">Criar conta</a>
<a href="#">Esqueci a senha</a>
</div>

<footer>
© 2026 ClipRN • Todos os direitos reservados
</footer>

</div>

</body>
</html>
